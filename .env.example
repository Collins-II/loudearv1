# Core application
MONGODB_URL=
NEXT_AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000
# Optional alias; set for production canonical links and Socket.IO CORS
NEXT_PUBLIC_APP_URL=

# OAuth providers are enabled only when both values are present
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# Advertising (primary monetization)
# Google AdSense publisher id, for example ca-pub-0000000000000000
NEXT_PUBLIC_GOOGLE_ADSENSE_ID=
# Optional AdSense ad unit ids; house/sponsor creatives are shown when unset
NEXT_PUBLIC_ADSENSE_SLOT_LEADERBOARD=
NEXT_PUBLIC_ADSENSE_SLOT_SQUARE=
NEXT_PUBLIC_ADSENSE_SLOT_FLUID=

# E-commerce (cart, licensing and Stripe checkout) is disabled unless set to true
NEXT_PUBLIC_ECOMMERCE_ENABLED=false

# Cloudinary media uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=

# Stripe checkout (only used when e-commerce is enabled)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=

# Royalty invitation email (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Mobile-money collection and payout providers (optional)
MTN_OAUTH_URL=
MTN_BASE_URL=
MTN_COLLECTION_URL=
MTN_DISBURSE_URL=
MTN_SUBSCRIPTION_KEY=
MTN_API_USER=
MTN_API_KEY=
MTN_ENV=sandbox
AIRTEL_BASE_URL=
AIRTEL_DISBURSE_URL=
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=
AIRTEL_API_KEY=
